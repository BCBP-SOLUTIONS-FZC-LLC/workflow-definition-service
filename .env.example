# Application
APP_ENV=dev                          # dev | prod
BUILD_VERSION=local

# Server
HTTP_PORT=8080
GRPC_PORT=9090

# platform-gincommon — OTel tracing
OTEL_SERVICE_NAME=workflow-definition-svc
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1.0

# PostgreSQL (pgx DSN)
DATABASE_URL=postgres://wfdef:wfdef@localhost:5432/workflow_definition?sslmode=disable
PG_MAX_CONNS=10
PG_MIN_CONNS=2
PG_SLOW_QUERY_THRESHOLD_MS=200

# Valkey / Redis
VALKEY_ADDR=localhost:6379
VALKEY_PASSWORD=

# AWS — SNS / SQS
# When AWS_USE_STUB=true the service uses in-process no-op stubs instead of
# real AWS clients. Set to false and provide real values in staging/production.
AWS_USE_STUB=true
AWS_REGION=us-east-1
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:wf.template.events
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/membership-wf-q

# Outbox relay worker
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50

# Outbound service dependencies
ORG_MEMBERSHIP_BASE_URL=http://localhost:8081
EXECUTION_SERVICE_ADDR=localhost:9091
