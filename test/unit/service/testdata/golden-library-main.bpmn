<?xml version="1.0" encoding="UTF-8"?>
<!-- The golden library-calls workflow: see golden_test.go. -->
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  id="Def_Golden" targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="Process_Golden" name="Golden" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_eng" name="Engineering"><bpmn:extensionElements><zeebe:properties><zeebe:property name="dept_id" value="2200a5ae-2466-54f7-a1d8-243106e05705"/></zeebe:properties></bpmn:extensionElements>
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA_Eng</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ops" name="Ops"><bpmn:extensionElements><zeebe:properties><zeebe:property name="dept_id" value="92fd92cf-4b2c-58dc-bf98-f3d0af729876"/></zeebe:properties></bpmn:extensionElements>
        <bpmn:flowNodeRef>CA_Ops</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1"/>
    <bpmn:callActivity id="CA_Eng" name="Review in Engineering">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_Review"/>
        <zeebe:ioMapping><zeebe:input source='{"Review_Check::Check_Task":"018f2d3c-0000-7000-8000-0000000000c1"}' target="Assignees"/></zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:callActivity id="CA_Ops" name="Review in Ops">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_Review"/>
        <zeebe:ioMapping><zeebe:input source='{"Review_Task":"018f2d3c-0000-7000-8000-0000000000b2","Review_Check::Check_Task":"018f2d3c-0000-7000-8000-0000000000c2"}' target="Assignees"/></zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:endEvent id="End_1"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="CA_Eng"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="CA_Eng" targetRef="CA_Ops"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="CA_Ops" targetRef="End_1"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_Golden">
      <bpmndi:BPMNShape id="Lane_eng_di" bpmnElement="Lane_eng"/>
      <bpmndi:BPMNShape id="Lane_ops_di" bpmnElement="Lane_ops"/>
      <bpmndi:BPMNShape id="Start_1_di" bpmnElement="Start_1"/>
      <bpmndi:BPMNShape id="CA_Eng_di" bpmnElement="CA_Eng"/>
      <bpmndi:BPMNShape id="CA_Ops_di" bpmnElement="CA_Ops"/>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1"/>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"/>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"/>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"/>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
