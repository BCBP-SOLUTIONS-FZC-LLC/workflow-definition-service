# DENY ALL only explicitly whitelisted patterns are tracked
*

# Allow directory traversal
!*/

# SOURCE
!*.go
!*.proto
!*.sql
!mermaid-init.js
!CLAUDE.md

# PROJECT & CONFIG FILES
!.gitignore
!.env.example
!go.mod
!go.sum
!Makefile
!sqlc.yaml
!buf.yaml
!buf.gen.yaml
!.golangci.yml
!docker-compose.yml
!mkdocs.yml
!requirements-docs.txt
!*.md
!.gitkeep
!.github/workflows/ci.yml
!.github/workflows/validate.yml
!.github/workflows/release.yml
!.github/CODEOWNERS
!.github/dependabot.yml
!.github/pull_request_template.md
!.github/ISSUE_TEMPLATE/
!Dockerfile
!openapi.yaml
!localstack-init.sh
!smoke-test.sh

# RE-IGNORE: local platform library copies (fetched as Go modules via GOPRIVATE)
platform-libs/

# RE-IGNORE: generated output
# (directories ignored here take precedence over !*.go above)
/gen/
/internal/adapter/outbound/postgres/db/
/internal/core/port/mocks/
vendor/

# RE-IGNORE: build & tooling
/bin/
/.tools/
.go/
# RE-IGNORE: coverage reports
/.coverage/

# RE-IGNORE: MkDocs built site
/site/

# RE-IGNORE: secrets & local env
.env
*.env
*.local

# SYSTEM FILES
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.AppleDouble

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

