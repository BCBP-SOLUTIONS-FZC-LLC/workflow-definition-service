      <bpmndi:BPMNShape id="InnerEnd_1_di" bpmnElement="InnerEnd_1">
        <dc:Bounds x="548" y="112" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <!-- Boundary error event on SubProcess_1 -->
      <bpmndi:BPMNShape id="BE_Error_1_di" bpmnElement="BE_Error_1">
        <dc:Bounds x="570" y="200" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <!-- QA lane elements -->
      <bpmndi:BPMNShape id="Task_qa_review_di" bpmnElement="Task_qa_review">
        <dc:Bounds x="660" y="285" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="822" y="307" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <!-- Sequence flow edges (outer process) -->
      <bpmndi:BPMNEdge id="Flow_start_sub_di" bpmnElement="Flow_start_sub">
        <di:waypoint x="198" y="125"/>
        <di:waypoint x="248" y="125"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_sub_qa_di" bpmnElement="Flow_sub_qa">
        <di:waypoint x="588" y="125"/>
        <di:waypoint x="624" y="125"/>
        <di:waypoint x="624" y="325"/>
        <di:waypoint x="660" y="325"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_error_qa_di" bpmnElement="Flow_error_qa">
        <di:waypoint x="588" y="218"/>
        <di:waypoint x="624" y="218"/>
        <di:waypoint x="624" y="325"/>
        <di:waypoint x="660" y="325"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_qa_end_di" bpmnElement="Flow_qa_end">
        <di:waypoint x="760" y="325"/>
        <di:waypoint x="822" y="325"/>
      </bpmndi:BPMNEdge>
      <!-- Sequence flow edges (inner subprocess) -->
      <bpmndi:BPMNEdge id="InnerFlow_start_prep_di" bpmnElement="InnerFlow_start_prep">
