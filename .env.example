# Application
APP_ENV=dev                          # dev | prod
BUILD_VERSION=local

# Server
HTTP_PORT=8080
# METRICS_PORT: separate from HTTP_PORT so NetworkPolicy can scope Prometheus
# scrape ingress independently of the API port.
METRICS_PORT=9091

# platform-gincommon — OTel tracing
OTEL_SERVICE_NAME=workflow-definition-service
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1.0

# PostgreSQL (pgx DSN)
# Direct to Postgres (default — local dev without PgBouncer):
DATABASE_URL=postgres://wfdef:wfdef@localhost:5432/workflow_definition?sslmode=disable
# Via PgBouncer (also set PG_BOUNCER_MODE=true and PG_MIN_CONNS=0):
# DATABASE_URL=postgres://wfdef:wfdef@localhost:6432/workflow_definition?sslmode=disable
PG_MAX_CONNS=10
PG_MIN_CONNS=2
PG_SLOW_QUERY_THRESHOLD_MS=200
# true when DATABASE_URL points to PgBouncer: switches pgx to simple protocol +
# transaction-local GUC injection. Migrations must still use a direct Postgres URL.
PG_BOUNCER_MODE=false
# MIGRATION_DATABASE_URL: direct Postgres DSN for the migrate subcommand.
# Required when DATABASE_URL points to PgBouncer (golang-migrate uses session advisory locks).
# Unset = uses DATABASE_URL (for local dev pointing directly at Postgres).
# MIGRATION_DATABASE_URL=postgres://wfdef:wfdef@localhost:5432/workflow_definition?sslmode=disable
# DATABASE_FALLBACK_URL: startup-only fallback if the primary DSN (DATABASE_URL) is unreachable.
# Tried once at boot when PgBouncer may not be ready (rolling deploys, startup ordering).
# Not used for runtime reconnection — runtime errors propagate to callers as normal.
# DATABASE_FALLBACK_URL=postgres://wfdef:wfdef@localhost:5432/workflow_definition?sslmode=disable
# SYSTEM_DATABASE_URL: BYPASSRLS DSN for scope=global module/template writes. Unset = uses DATABASE_URL.
# SYSTEM_DATABASE_URL=postgres://wfdef:wfdef@localhost:5432/workflow_definition?sslmode=disable

# Valkey / Redis
VALKEY_ADDR=localhost:6379
VALKEY_PASSWORD=
VALKEY_DIAL_TIMEOUT=2s
VALKEY_READ_TIMEOUT=1s
VALKEY_WRITE_TIMEOUT=1s
# CACHE_COMPILED_PLAN_TTL bounds the internal compiled-plan read's
# cache (key wf:plan:<tenant>:<version>); entries are also deleted on state change.
CACHE_COMPILED_PLAN_TTL=1h
# IDEMPOTENCY_TTL bounds the internal-route idempotency-key response cache
# (2xx responses only, keyed with a SHA-256 hash of the raw request body).
IDEMPOTENCY_TTL=24h

# Required as the x-internal-token header on the internal route group
# (/api/v1/internal). Required outside dev; empty disables the check in dev.
# NetworkPolicy/mesh remains the primary control either way.
INTERNAL_API_TOKEN=

# Outbound service dependencies
ORG_MEMBERSHIP_BASE_URL=http://localhost:8081
MEMBERSHIP_CLIENT_TIMEOUT=10s
# The Execution Service internal API (go run ./cmd/stub/execution serves one on :8083)
# and its INTERNAL_API_TOKEN; both are required outside dev.
EXECUTION_SERVICE_URL=http://localhost:8083
EXECUTION_SERVICE_TOKEN=
EXECUTION_CLIENT_TIMEOUT=5s

# OpenBao — connector credential secrets (author-time writes, see WriteCredential)
OPENBAO_ADDR=
OPENBAO_TOKEN=
OPENBAO_MOUNT=secret
SECRETS_CLIENT_TIMEOUT=5s

# Connector rest-call alias registry — hosts an alias BaseURL may point at.
# Comma-separated; an entry starting with "." is a suffix rule, anything
# else must match the host exactly. Empty rejects every alias write:
# restcall attaches the real internal service token to whatever host an
# alias names, so an unbounded registry leaks that credential.
CONNECTOR_ALIAS_ALLOWED_HOSTS=.svc.cluster.local

# Sampled RLS violations in rls_violation_log are exported as a counter every
# interval from the system pool; rows older than the retention are deleted.
RLS_VIOLATION_EXPORT_INTERVAL=30s
RLS_VIOLATION_RETENTION=168h
